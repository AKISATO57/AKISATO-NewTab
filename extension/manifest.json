{
  "manifest_version": 3,
  "name": "AKISATO 灯塔",
  "short_name": "AKISATO",
  "description": "轻快、可自定义的浏览器新标签页。",
  "version": "1.0.26",
  "permissions": [
    "bookmarks",
    "favicon",
    "history",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://suggestqueries.google.com/*",
    "https://api.bing.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
